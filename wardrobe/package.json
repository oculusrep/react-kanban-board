{
  "name": "wardrobe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types >/dev/null && tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply wardrobe --local",
    "db:migrate:remote": "wrangler d1 migrations apply wardrobe --remote"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  }
}
